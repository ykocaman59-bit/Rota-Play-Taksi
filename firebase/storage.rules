rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    match /driver-documents/{driverId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == driverId || isAdmin());
      allow write: if false;   // belge yükleme kapatıldı; eski belgeler yalnızca okunabilir
    }
  }
}
