rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(uid())); }
    function driverDoc() { return get(/databases/$(database)/documents/drivers/$(uid())).data; }
    function isApprovedDriver() {
      return signedIn()
        && request.auth.token.email_verified == true          // şoför Gmail'ini doğrulamış olmalı
        && exists(/databases/$(database)/documents/drivers/$(uid()))
        && driverDoc().status == 'approved';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Yaklaşık uzaklık (km). Türkiye enlemleri için boylam çarpanı ≈ 0.777.
    function distKm(aLat, aLon, bLat, bLon) {
      return math.sqrt(math.pow((aLat - bLat) * 111.2, 2) + math.pow((aLon - bLon) * 111.2 * 0.777, 2));
    }
    function okStars(v) { return v is int && v >= 1 && v <= 5; }
    function okIban(v) { return v is string && v.matches('^TR[0-9]{24}$'); }

    // Şoförün seviyesine göre talep alma yarıçapı (km). TaxiStore.applyLevel ile aynı olmalı.
    function levelRadius() {
      return !exists(/databases/$(database)/documents/driverStats/$(uid())) ? 3 :
        (get(/databases/$(database)/documents/driverStats/$(uid())).data.count >= 100 && get(/databases/$(database)/documents/driverStats/$(uid())).data.avg >= 4.8) ? 15 :
        (get(/databases/$(database)/documents/driverStats/$(uid())).data.count >= 60 && get(/databases/$(database)/documents/driverStats/$(uid())).data.avg >= 4.6) ? 12 :
        (get(/databases/$(database)/documents/driverStats/$(uid())).data.count >= 30 && get(/databases/$(database)/documents/driverStats/$(uid())).data.avg >= 4.3) ? 8 :
        (get(/databases/$(database)/documents/driverStats/$(uid())).data.count >= 10 && get(/databases/$(database)/documents/driverStats/$(uid())).data.avg >= 4.0) ? 5 : 3;
    }

    // Yöneticiler: Firebase konsolundan elle eklenir, kimse uygulamadan yönetici olamaz
    match /admins/{id} {
      allow read: if signedIn() && uid() == id;
    }

    // Şoförler: kayıt olur (bekliyor), sadece yönetici onaylar
    match /drivers/{id} {
      allow read: if isAdmin() || (signedIn() && uid() == id);
      allow create: if signedIn() && uid() == id
        && request.resource.data.keys().hasOnly(['name', 'phone', 'plate', 'email', 'iban', 'vehicleType', 'status', 'createdAt', 'legalConsent', 'legalConsentAt', 'legalConsentVersion'])
        && request.resource.data.status == 'pending'
        && request.resource.data.vehicleType == 'yellow_taxi'
        && request.resource.data.email == request.auth.token.email
        && okIban(request.resource.data.iban)
        && request.resource.data.name.size() <= 60
        && request.resource.data.plate.size() <= 20
        && request.resource.data.plate.matches('^(0[1-9]|[1-7][0-9]|8[01]) T[A-PR-VYZ]{0,2} [0-9]{2,4}$')   // 81 il ticari taksi plakası
        && request.resource.data.legalConsent == true          // yasal sorumluluk onayı zorunlu
        && request.resource.data.legalConsentVersion is string;
      // status, ad, telefon ve plaka yalnızca yönetici tarafından değiştirilebilir; şoför sadece IBAN'ını güncelleyebilir.
      allow update: if isAdmin()
        // şoför kendi IBAN'ını güncelleyebilir
        || (signedIn() && uid() == id
            && changed().hasOnly(['iban'])
            && okIban(request.resource.data.iban));
    }

    // Yolculuklar
    match /rides/{rid} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.passengerUid == uid())
        || (signedIn() && resource.data.driverUid == uid())
        || (isApprovedDriver() && resource.data.status == 'searching');

      // Yolcu talep açar
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['passengerUid', 'passengerName', 'status', 'pickup', 'dest', 'createdAt', 'declined', 'driverUid'])
        && request.resource.data.passengerUid == uid()
        && request.resource.data.status == 'searching'
        && request.resource.data.driverUid == null
        && request.resource.data.declined.size() == 0
        && request.resource.data.passengerName.size() <= 60;

      allow update: if isAdmin()

        // yolcu: iptal / süre doldu
        || (signedIn() && resource.data.passengerUid == uid()
            && resource.data.status in ['searching', 'accepted']
            && request.resource.data.status in ['cancelled', 'expired']
            && changed().hasOnly(['status']))

        // yolcu: şoförü puanlar (bir kez)
        || (signedIn() && resource.data.passengerUid == uid()
            && resource.data.status == 'completed'
            && !('driverRating' in resource.data)
            && changed().hasOnly(['driverRating'])
            && okStars(request.resource.data.driverRating))

        // şoför: talebi kabul eder (yalnızca hâlâ aranıyorsa ve 5 km içindeyse; ilk yazan kazanır)
        || (isApprovedDriver()
            && resource.data.status == 'searching'
            && request.resource.data.status == 'accepted'
            && request.resource.data.driverUid == uid()
            && request.resource.data.driverName == driverDoc().name
            && request.resource.data.driverPlate == driverDoc().plate
            && request.resource.data.driverIban == driverDoc().get('iban', '')
            && !(uid() in resource.data.declined)
            && request.resource.data.driverLat is number && request.resource.data.driverLon is number
            && distKm(request.resource.data.driverLat, request.resource.data.driverLon, resource.data.pickup.lat, resource.data.pickup.lon) <= levelRadius() + 0.5
            && changed().hasOnly(['status', 'driverUid', 'driverName', 'driverPlate', 'driverIban', 'driverPhone', 'acceptedAt', 'driverCancelled', 'driverLat', 'driverLon']))

        // şoför: yolcuyu almadan önce iptal eder, talep yeniden aranır
        || (signedIn() && resource.data.driverUid == uid()
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'searching'
            && request.resource.data.driverUid == null
            && uid() in request.resource.data.declined
            && changed().hasOnly(['status', 'driverUid', 'driverName', 'driverPlate', 'driverIban', 'driverPhone', 'driverCancelled', 'declined', 'createdAt', 'driverLat', 'driverLon']))

        // şoför: yolcuyu aldı
        || (signedIn() && resource.data.driverUid == uid()
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'picked_up'
            && changed().hasOnly(['status', 'pickedAt']))

        // şoför: canlı konum
        || (signedIn() && resource.data.driverUid == uid()
            && resource.data.status in ['accepted', 'picked_up']
            && changed().hasOnly(['driverLat', 'driverLon']))

        // şoför: yolculuğu bitirir, taksimetre tutarını yazar
        || (signedIn() && resource.data.driverUid == uid()
            && resource.data.status == 'picked_up'
            && request.resource.data.status == 'completed'
            && request.resource.data.fare is number
            && request.resource.data.fare >= 0 && request.resource.data.fare <= 100000
            && changed().hasOnly(['status', 'fare', 'doneAt']))

        // şoför: yolcuyu puanlar (bir kez)
        || (signedIn() && resource.data.driverUid == uid()
            && resource.data.status == 'completed'
            && !('passengerRating' in resource.data)
            && changed().hasOnly(['passengerRating'])
            && okStars(request.resource.data.passengerRating));

      // Yolcunun telefonu: sadece kendisi, atanan şoför ve yönetici görür
      match /private/{doc} {
        allow create: if signedIn()
          && get(/databases/$(database)/documents/rides/$(rid)).data.passengerUid == uid()
          && request.resource.data.keys().hasOnly(['name', 'phone']);
        allow read: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/rides/$(rid)).data.passengerUid == uid())
          || (signedIn() && get(/databases/$(database)/documents/rides/$(rid)).data.driverUid == uid());
      }
    }

    // Puan özetleri: yalnızca ilgili yolculuğun puanıyla, yolculuk başına bir kez artırılabilir
    match /driverStats/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['sum', 'count', 'avg', 'lastRide', 'name'])
        && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.lastRide)).data.passengerUid == uid()
        && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.lastRide)).data.driverUid == id
        && request.resource.data.lastRide != (resource == null ? '' : resource.data.lastRide)
        && request.resource.data.count == (resource == null ? 0 : resource.data.count) + 1
        && request.resource.data.sum == (resource == null ? 0 : resource.data.sum)
             + getAfter(/databases/$(database)/documents/rides/$(request.resource.data.lastRide)).data.driverRating);
    }
    match /passengerStats/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || (signedIn()
        && request.resource.data.keys().hasOnly(['sum', 'count', 'avg', 'lastRide', 'name'])
        && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.lastRide)).data.driverUid == uid()
        && getAfter(/databases/$(database)/documents/rides/$(request.resource.data.lastRide)).data.passengerUid == id
        && request.resource.data.lastRide != (resource == null ? '' : resource.data.lastRide)
        && request.resource.data.count == (resource == null ? 0 : resource.data.count) + 1
        && request.resource.data.sum == (resource == null ? 0 : resource.data.sum)
             + getAfter(/databases/$(database)/documents/rides/$(request.resource.data.lastRide)).data.passengerRating);
    }

    // Hareket kayıtları: herkes sadece kendi adına yazar, yalnızca yönetici okur
    match /events/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'who', 'name', 'detail', 't'])
        && request.resource.data.uid == uid()
        && request.resource.data.name.size() <= 40
        && request.resource.data.detail.size() <= 200;
      allow read: if isAdmin();
    }
  }
}
